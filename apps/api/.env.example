NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/replyka?schema=public"
JWT_SECRET="change-me-en-production-32-chars-min"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# Facebook / Meta (pour la liaison)
# FB_APP_ID=""
# FB_APP_SECRET=""
# FB_REDIRECT_URI="http://localhost:4000/api/accounts/facebook/callback"

FB_APP_ID="ton_app_id"
FB_APP_SECRET="ton_app_secret"
FB_REDIRECT_URI="http://localhost:4000/api/facebook/callback"
FB_API_VERSION="v21.0"

# Webhooks Meta : même valeur que "Verify token" dans le tableau de bord Meta
# URL de rappel à déclarer : https://<domaine-public>/api/webhooks/meta
FB_WEBHOOK_VERIFY_TOKEN="choisis-une-chaine-secrete"
# Permissions OAuth (optionnel) : remplace la liste par défaut si l'app Meta en refuse certaines
# FB_SCOPES="pages_show_list,pages_read_engagement,pages_manage_engagement,pages_messaging"

# Connexion au compte SuiteFlow avec Facebook : utilise la même app (FB_APP_ID / FB_APP_SECRET).
# Adresse de retour à déclarer dans Meta (Facebook Login → URI de redirection OAuth valides) :
#   http://localhost:4000/api/auth/facebook/callback
# Connexion avec Google : console.cloud.google.com → API et services → Identifiants →
# « ID client OAuth » de type « Application Web ». URI de redirection autorisé à déclarer :
#   http://localhost:4000/api/auth/google/callback
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""
# Adresse de l'API vue par le navigateur (base des adresses de retour ci-dessus). Par défaut : origine de FB_REDIRECT_URI.
# API_URL="https://api.mondomaine.com"

# Adresse publique de l'API (ex. https://api.mondomaine.com) : Instagram doit pouvoir y télécharger
# les images des publications programmées. Par défaut : origine de FB_REDIRECT_URI.
# PUBLIC_API_URL="https://api.mondomaine.com"
# Planification : vérification des publications à envoyer (secondes, 0 = désactivé)
SCHEDULER_SECONDS=30
# Lives : lecture des commentaires des sessions actives (secondes, 0 = désactivé)
LIVE_POLL_SECONDS=5

# Réponses automatiques : polling de secours en secondes (0 = webhooks uniquement)
AUTOREPLY_POLL_SECONDS=30

# Modèle IA gratuit — toute API compatible OpenAI. Choisissez UN bloc :
# Groq (gratuit, sans carte bancaire) — clé : https://console.groq.com/keys
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-oss-20b"
# Google Gemini (gratuit, Flash / Flash-Lite) — clé : https://aistudio.google.com/apikey
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_MODEL="gemini-3.1-flash-lite"   (vérifiez le nom exact dans Google AI Studio)
# Ollama (100 % local, sans clé) — https://ollama.com puis : ollama pull qwen2.5
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="qwen2.5"

# Abonnements : paiement Papi.mg (https://docs.papi.mg) — tableau de bord Papi → Clés API
# Clé API (en-tête Token) et clé secrète de signature des notifications (pwhsec_…)
# PAPI_API_KEY=""
# PAPI_SECRET_KEY="pwhsec_…"
# Paiements de test (numéros sandbox) : true par défaut hors production. Le mode de l'application
# Papi (Test / Production) se règle aussi dans son tableau de bord.
# PAPI_TEST_MODE=true
# Validité d'un lien de paiement en heures (1 à 596)
# PAPI_LINK_HOURS=24
# Papi envoie la confirmation de paiement à ${PUBLIC_API_URL}/api/billing/papi/notify : l'adresse doit
# être publique (en dev : npm run dev:public). Sans elle, les paiements sont vérifiés par interrogation :
# BILLING_RECONCILE_SECONDS=120
# Live Manager à l'unité : prix d'une heure en ariary (heures utilisées après le quota du mois, ou sans abonnement)
# LIVE_HOUR_PRICE=2500
# Commission Papi quand la notification ne la donne pas (bénéfice du tableau de bord administrateur) :
# mode de votre compte Papi (papi.mg/pricing) : transit (3,6 à 4,2 % selon le moyen) ou direct (1,20 %)
# PAPI_FEE_MODE=transit
# ou un pourcentage unique : PAPI_FEE_PERCENT=3.8
# Coût estimé d'une réponse IA en ariary
# AI_COST_PER_REPLY=1

# E-mails (codes de validation en deux étapes). Gmail : activez la validation en deux étapes de votre
# compte Google, puis créez un « mot de passe d'application » (myaccount.google.com/apppasswords).
# Sans SMTP : hors production, les codes s'affichent dans la console de l'API.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="vous@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# MAIL_FROM="SuiteFlow <vous@gmail.com>"
# Clé de chiffrement des secrets Google Authenticator (par défaut : dérivée de JWT_SECRET ; ne la changez
# plus une fois des comptes protégés, sinon ils devront réactiver l'application)
# TWO_FACTOR_KEY=""

# Cloudflare Turnstile (anti-robot) sur la connexion, l'inscription et le mot de passe oublié :
# dash.cloudflare.com → Turnstile → Ajouter un site. Sans clés : clés de test Cloudflare hors production.
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
